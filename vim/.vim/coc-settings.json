{
    "python.formatting.provider": "black",
    "python.formatting.blackPath": "/opt/homebrew/bin/black",
    "python.linting.ruffPath": "/opt/homebrew/bin/ruff",
    "python.linting.enabled": true,
    "python.linting.ruffEnabled": true,
    "python.linting.ruffArgs": [
        "--ignore",
        "E501"
    ],
    "pyright.organizeimports.provider": "ruff",
    "rust-analyzer.checkOnSave": false,
    // exit coc commands with ctrl-c
    "list.normalMappings": {
        "<C-c>": "do:exit"
    },
    "list.insertMappings": {
        "<C-c>": "do:exit"
    },
}
// vim: ft=jsonc
